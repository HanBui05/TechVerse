{
  "model": "sonnet",
  "enabledPlugins": {
    "ui-ux-pro-max@ui-ux-pro-max-skill": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-log-check.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

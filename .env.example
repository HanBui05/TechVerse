# PostgreSQL
POSTGRES_DB=techverse
POSTGRES_USER=techverse
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_HOST_PORT=5432

# Redis
REDIS_HOST_PORT=6379

# Server
SERVER_PORT=8080
JWT_SECRET_KEY=replace-with-a-local-secret-at-least-32-characters-long
PASSWORD_RESET_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
SENDGRID_TEMPLATE_RESET_PASSWORD_OTP=replace-with-sendgrid-dynamic-template-id
WEB_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
SPRING_PROFILES_ACTIVE=dev

# Direct local server execution (Compose overrides these with service names)
DATABASE_HOST=localhost
DATABASE_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional initial admin for local development (dev profile only)
INITIAL_ADMIN_EMAIL=admin@techverse.local
INITIAL_ADMIN_PASSWORD=

# Cloudinary (backend only; leave blank to disable uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ARTICLE_FOLDER=techverse/articles
CLOUDINARY_CLEANUP_ENABLED=true

# AI assist (backend only; never expose to the frontend). AI_MODEL_CHAT=none disables AI.
AI_MODEL_CHAT=none
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_CHAT_MODEL=openai/gpt-oss-120b
AI_TIMEOUT=60s
AI_MAX_RETRIES=0
AI_REASONING_EFFORT=low
AI_MAX_COMPLETION_TOKENS=8192
AI_ASYNC_TIMEOUT=195s
AI_OUTLINE_PER_DAY=10
AI_DRAFT_PER_DAY=5
AI_TUTOR_PER_DAY=20
AI_TUTOR_TIMEOUT=60s
AI_EXERCISE_PER_DAY=10
AI_EXERCISE_TIMEOUT=60s
AI_BURST_PER_MINUTE=3

# VietQR receiving account for course payments (backend only). Leave blank to disable buying.
# VIETQR_BANK_ID: bank BIN or short code from https://api.vietqr.io/v2/banks; account number digits only.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact2

# payOS (backend only, keys from my.payos.vn). All four set = every new order is paid through payOS;
# any blank = VietQR with Admin confirmation. Return base: the web app URL, e.g. http://localhost:3000.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_BASE_URL=

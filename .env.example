# PostgreSQL
POSTGRES_DB=techverse
POSTGRES_USER=techverse
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_HOST_PORT=5432

# Redis
REDIS_HOST_PORT=6379

# Server
SERVER_PORT=8080
JWT_SECRET_KEY=replace-with-a-local-secret-at-least-32-characters-long
SPRING_PROFILES_ACTIVE=dev

# Direct local server execution (Compose overrides these with service names)
DATABASE_HOST=localhost
DATABASE_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
